<?xml version="1.0"?>
<package format="3">
  <name>drone_detector</name>
  <version>0.0.1</version>
  <description>Modular ROS 2 fixed-LiDAR drone detection pipeline using PCL, RANSAC, DBSCAN, and RViz markers.</description>

  <maintainer email="noreply@example.com">drone_detector</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>eigen</depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
