<robot name="fixed_lidar">
  <!--
    Fixed LiDAR detection system

    Frame structure:

      base_link
          |
          | 3.0 m
          |
      fixed_lidar
  -->
  <!-- ========================= -->
  <!-- Base / pole                -->
  <!-- ========================= -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 1.5"/>
      <geometry>
        <cylinder length="3.0" radius="0.05"/>
      </geometry>
      <material name="pole_material">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
  </link>
  <!-- ========================= -->
  <!-- LiDAR frame               -->
  <!-- ========================= -->
  <link name="fixed_lidar">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <geometry>
        <cylinder length="0.15" radius="0.15"/>
      </geometry>
      <material name="lidar_material">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <!-- ========================= -->
  <!-- Pole -> LiDAR transform   -->
  <!-- ========================= -->
  <joint name="fixed_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="fixed_lidar"/>
    <origin rpy="0 0 0" xyz="0 0 3.0"/>
  </joint>
  <!-- Camera Base Link -->
  <link name="camera_base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.10"/>
      <geometry>
        <cylinder length="0.20" radius="0.30"/>
      </geometry>
      <material name="base_material">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
  </link>
  <!-- Connect Camera Base to the LiDAR Parent Link -->
  <joint name="camera_base_joint" type="fixed">
    <parent link="fixed_lidar"/>
    <child link="camera_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.15"/>
  </joint>
  <!-- Pan Link -->
  <link name="pan_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.15"/>
      <geometry>
        <cylinder length="0.10" radius="0.22"/>
      </geometry>
      <material name="pan_material">
        <!-- <color rgba="0.15 0.15 0.15 1.0"/> -->
        <!-- <color rgba="1.0 0.0 0.0 1.0"/> -->
        <color rgba="0.0 0.0 1.0 1.0"/>
        <!-- <color rgba="1.0 1.0 0.0 1.0"/> -->
      </material>
    </visual>
  </link>
  <joint name="pan_joint" type="continuous">
    <parent link="camera_base_link"/>
    <child link="pan_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.20"/>
    <axis xyz="0 0 1"/>
    <!-- <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1.0"/> -->
    <limit effort="10" velocity="1.0"/>
  </joint>
  <!-- Tilt Body -->
  <link name="tilt_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.18"/>
      <geometry>
        <box size="0.18 0.18 0.36"/>
      </geometry>
      <material name="tilt_material">
        <!-- <color rgba="0.30 0.30 0.30 1.0"/> -->
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.20"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-1.0472" upper="1.0472" velocity="1.0"/>
  </joint>
  <!-- Camera Body -->
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.20 0 0"/>
      <geometry>
        <box size="0.40 0.20 0.20"/>
      </geometry>
      <material name="camera_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="tilt_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.36"/>
  </joint>
  <!-- ============================================================ -->
  <!-- 5. CAMERA SENSOR FRAME (Edge Center of camera_link Box)     -->
  <!-- ============================================================ -->
  <!-- Use explicit open & close tags for empty dummy links -->
  <link name="camera_sensor_link"/>
  <joint name="camera_sensor_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_sensor_link"/>
    <origin rpy="0 0 0" xyz="0.40 0 0"/>
  </joint>
  <!-- 6. Camera Optical Frame -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_sensor_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0"/>
  </joint>
  <!-- Gazebo Sim PTZ camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="ptz_camera" type="camera">
      <pose>0.40 0 0 0 0 0</pose>
      <topic>/ptz_camera</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>150.0</far>
        </clip>
      </camera>
      <gz_frame_id>camera_link</gz_frame_id>
    </sensor>
  </gazebo>
</robot>
